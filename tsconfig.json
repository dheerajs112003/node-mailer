{
  "compilerOptions": {
    "outDir": "./dist",
    "strict": false,                  
    "noImplicitAny": false,           
    "strictNullChecks": false,        
    "skipLibCheck": true,  
    
    "module": "nodenext",
    "target": "esnext",
    
    // Add these two lines to explicitly load Node types
    "lib": ["esnext"],
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force"
  }
}